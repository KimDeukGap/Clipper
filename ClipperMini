import json, os

FILE = "snippets.json"
data = json.load(open(FILE, "r", encoding="utf-8")) if os.path.exists(FILE) else {}

while True:
    print("\n--- [1] 목록 [2] 추가 [3] 삭제 [4] 종료 ---")
    cmd = input("선택: ")
    
    if cmd == "1":
        print("\n".join(f"- {k}: {v}" for k, v in data.items()) or "저장된 항목 없음")
    elif cmd == "2":
        k, v = input("제목: "), input("내용: ")
        data[k] = v
        json.dump(data, open(FILE, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
    elif cmd == "3":
        k = input("삭제할 제목: ")
        if data.pop(k, None): json.dump(data, open(FILE, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
    elif cmd == "4":
        break
